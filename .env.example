# ============================================================
# NexusChat - Environment Configuration Template
# Copy this file to .env and customize values as appropriate.
# Never commit .env with production credentials.
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexuschat
DB_SSL=false

# Authentication & Session Security
SESSION_SECRET=super_secret_session_key_replace_in_production_min_32_chars
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_chars
SESSION_EXPIRY_DAYS=7

# Client & CORS Configuration
CLIENT_URL=http://localhost:5173

# Frontend Environment Variables (used by client)
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000
